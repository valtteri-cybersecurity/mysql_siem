# Literal key=value data. Never commit real config/mysql.env credentials.
DB_HOST=localhost
DB_USER=pythonuser
DB_PASSWORD=replace-with-password
DB_NAME=mysql_siem
DB_PORT=3306
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
# Optional trusted CA file. Remote hosts always require verified TLS.
DB_SSL_CA=
