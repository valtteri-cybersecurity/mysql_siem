# Copy to config/adguard.env and set private values. Do not commit that file.
ADGUARD_URL=https://adguard.example.org
ADGUARD_USERNAME=replace-me
ADGUARD_PASSWORD=replace-me
ADGUARD_SOURCE_NAME=adguard-home
ADGUARD_CONNECT_TIMEOUT=5
ADGUARD_READ_TIMEOUT=30
ADGUARD_PAGE_SIZE=1000
# Optional PEM CA/certificate path; never disable TLS verification.
# ADGUARD_CA_BUNDLE=/path/to/adguard-ca.pem
# Source query/checkpoint window only; does not delete stored DNS history.
DNS_RETENTION_DAYS=30
