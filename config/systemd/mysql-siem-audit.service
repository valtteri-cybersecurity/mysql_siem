
# Managed by mysql_siem Audit; administrator installation only.
[Unit]
Description=mysql_siem bounded Linux Audit collector
After=auditd.service mysql.service
Requires=auditd.service
ConditionPathExists=!/usr/local/lib/.mysql_siem-local/maintenance

[Service]
Type=oneshot
User=root
Group=root
# The fixed entrypoint renews ACLs, then permanently drops UID/GID.
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/mysql_siem/config/audit_launcher.py
TimeoutStartSec=55
SuccessExitStatus=75
NoNewPrivileges=true
CapabilityBoundingSet=CAP_AUDIT_CONTROL CAP_SETUID CAP_SETGID
ProtectSystem=strict
# ACL renewal needs access to auditd log files.
# The collector UID receives only read access via POSIX ACL.
ReadWritePaths=/var/log/mysql_siem/audit /var/log/audit
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
