# Values are read literally. Leave collector ID empty to use the local hostname.
SSH_AUTH_LOGFILE=/var/log/auth.log
SSH_AUTH_COLLECTOR_ID=
SSH_AUTH_MAX_SECONDS=30

# Prefer precise ISO 8601 timestamps from rsyslog; no system configuration is
# changed automatically. Traditional syslog needs an administrator-verified
# source interval with offsets (maximum 366 days) and the source IANA timezone.
# The interval must cover this source including its rotations. It expires and
# needs maintenance; never infer the year from the current clock or file mtime.
# Leave these unset unless the source context has been verified.
# SSH_AUTH_SYSLOG_START=2026-01-01T00:00:00+02:00
# SSH_AUTH_SYSLOG_END=2027-01-01T00:00:00+02:00
# SSH_AUTH_SYSLOG_TIMEZONE=Europe/Helsinki

SSH_BRUTE_FORCE_BATCH_SIZE=1000
SSH_BRUTE_FORCE_LATE_SECONDS=600
SSH_BRUTE_FORCE_MAX_BUFFER_EVENTS=10000
