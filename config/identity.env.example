# Copy to identity.env after an administrator has registered/approved the source
# and collector IDs. IDs come from the database; never derive them from names/IPs.
# Configure only sources collected on this machine. No secrets belong here.
# SIEM_COLLECTOR_ID=1
# SIEM_UFW_SOURCE_ID=1
# SIEM_AUTH_SOURCE_ID=2
# SIEM_SYSTEM_SOURCE_ID=3
# SIEM_FILESYSTEM_SOURCE_ID=4
# SIEM_SECURITY_SOURCE_ID=5
# SIEM_DNS_SOURCE_ID=6
